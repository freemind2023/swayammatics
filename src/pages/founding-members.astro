---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";

const members = [
  {
    name: "Sanmit Shah",
    role: "Founder, Practical EduSkills",
    image: "/images/team/sanmit-shah.jpg",
    bio: [
      "Sanmit Shah started like any ambitious student — following the prescribed path, collecting certificates, hoping the degree would open doors. It didn't. Not the way it should have.",
      "19 years into his career, he kept meeting the same story in different faces: brilliant students, good marks, zero readiness for the real world. Theory without practice. Knowledge without application. Potential without direction.",
      "That empathy became a mission. He didn't just write about change — he built an entirely new education system. Practical EduSkills was born not from a boardroom strategy, but from deep frustration and an equally deep belief: every student deserves a fair shot at a successful career.",
      "Today, with 2000+ transformed students and a movement that grows every morning at 5 AM, Sanmit Shah is not just an educator — he is a revolution in education.",
    ],
  },
  {
    name: "Keegan Francis",
    role: "Fractional CTO & Forward Deployment Engineer",
    image: "/images/team/keegan.webp",
    tagline: "Systems thinking, one interface at a time.",
    bio: [
      "I'm Keegan — a systems architect and frontend engineer exploring Bitcoin, food networks, and sustainable technology. I work as a Fractional CTO and Forward Deployment Engineer, embedding with teams that need both a strategic and a hands-on technical lead.",
      "Keegan brings over a decade of experience in software engineering and startups, with much of his background in FinTech. His journey with Food Web began during the COVID-19 pandemic when he and Justin, long-time friends, started hanging out more often. Through their conversations, Justin opened Keegan's eyes to the deeper issues in the food system, and Keegan had a realization: \"you can't eat money.\"",
      "After spending years helping startups in the financial world, Keegan was inspired to shift some of his focus toward something more tangible — supporting the growth of local food systems. As CTO of Food Web, Keegan used his technical expertise to build the infrastructure that powers the platform, drawing on his background in entrepreneurship, project management, and solutions architecture to connect people and resources in ways that strengthen local food networks and create real impact.",
    ],
  },
];
---

<Base
  title="Founding Members"
  meta_title="Founding Members — Swayammatics"
  description="Meet the founding members behind Swayammatics."
>
  <PageHeader
    title="Founding <strong>Members</strong>"
    subtitle="The people behind Swayammatics and Practical EduSkills."
  />

  <section class="section-sm pt-0">
    <div class="container">
      <div class="flex flex-col gap-16 max-w-220 mx-auto">
        {
          members.map((m) => (
            <div class="flex flex-col sm:flex-row gap-8 sm:gap-10 items-center sm:items-start text-center sm:text-left">
              <div class="relative shrink-0">
                <div class="absolute -inset-1.5 rounded-full bg-linear-to-br from-secondary via-primary to-primary-light opacity-80 blur-sm" />
                <img
                  src={m.image}
                  alt={m.name}
                  class="relative size-40 sm:size-48 rounded-full object-cover ring-4 ring-body shadow-xl"
                />
              </div>
              <div class="flex-1">
                <h3 class="text-h4 font-bold text-white mb-1">{m.name}</h3>
                {m.role && (
                  <p class="text-primary-light font-semibold mb-2">{m.role}</p>
                )}
                {"tagline" in m && m.tagline && (
                  <p class="text-white italic mb-4">{m.tagline}</p>
                )}
                {m.bio.length > 0 ? (
                  <div class="flex flex-col gap-3 text-text">
                    {m.bio.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                ) : (
                  <p class="text-text-dark italic">Bio coming soon.</p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
