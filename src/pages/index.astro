---
import Base from "@/layouts/Base.astro";
import ValueCard from "@/layouts/components/ValueCard.astro";
import BusinessNeeds from "@/layouts/components/BusinessNeeds.astro";
import ProcessCard from "@/layouts/components/ProcessCard.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import Faq from "@/layouts/components/Faq.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
const homepage = await getListPage("homepage", "-index");
const homepageData: Homepage = homepage.data;
---

<Base
  title="Swayammatics"
  meta_title="Swayammatics | Business Technology & Automation"
  description="Swayammatics helps businesses improve operations through AI automation, business process automation, system integration and intelligent technology solutions."
>
  <!-- Banner -->
  <section class="section-ph relative overflow-hidden">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="mb-20 text-center relative">
          <h1
            class="mb-8 lg:col-9 mx-auto text-h3 lg:text-h1 hasHighlight"
            set:html={markdownify(homepageData.banner.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto">{homepageData.banner.content}</p>
          <div class="flex gap-4 justify-center items-center flex-wrap">
            <a
              class="btn btn-primary"
              rel="noopener noreferrer"
              href={homepageData.banner.button_primary.link}
            >
              {homepageData.banner.button_primary.label}
            </a>
            <a
              class="btn btn-outline"
              rel="noopener noreferrer"
              href={homepageData.banner.button_secondary.link}
            >
              {homepageData.banner.button_secondary.label}
            </a>
          </div>
        </div>
        <div class="col-12">
          <div
            class="flex justify-center w-full perspective-near xl:perspective-dramatic"
          >
            <VideoShowcase />
          </div>
        </div>
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
    <div class="absolute top-0 left-0 flex flex-col gap-6 -z-10">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="567"
        height="558"
        fill="none"
      >
        <g opacity=".5">
          <g filter="url(#a-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#b-banner)"
              d="M-20.527-7.51 10.182-43l259.774 233.148-13.283 15.352-277.2-213.01Z"
            ></path></g
          >
          <g filter="url(#c-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#d-banner)"
              d="M-52 13.659-20.788-25l267.328 224.459-13.502 16.722-285.04-202.522Z"
            ></path></g
          >
          <g filter="url(#e-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#f-banner)"
              d="M-108.079-4.9-66.125-46l290.011 307.352-18.147 17.779-313.818-284.03Z"
            ></path></g
          >
          <g filter="url(#g-banner)"
            ><ellipse
              cx="143"
              cy="252.378"
              fill="var(--color-primary-light)"
              fill-opacity=".5"
              rx="143"
              ry="252.378"
              transform="scale(-1 1) rotate(46.133 191.203 -117.756)"
            ></ellipse></g
          >
        </g>
        <defs>
          <filter
            id="a-banner"
            width="338.484"
            height="296.5"
            x="-44.527"
            y="-67"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="c-banner"
            width="346.541"
            height="289.181"
            x="-76.001"
            y="-49"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="e-banner"
            width="379.965"
            height="373.131"
            x="-132.079"
            y="-70"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="g-banner"
            width="914.454"
            height="906.103"
            x="-348.178"
            y="-349.061"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="125"></feGaussianBlur></filter
          >
          <linearGradient
            id="b-banner"
            x1="-5.173"
            x2="258.744"
            y1="-25.255"
            y2="203.106"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
          <linearGradient
            id="d-banner"
            x1="-36.394"
            x2="235.144"
            y1="-5.671"
            y2="213.574"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
          <linearGradient
            id="f-banner"
            x1="-87.102"
            x2="208.568"
            y1="-25.45"
            y2="276.359"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
        </defs>
      </svg>
    </div>
  </section>
  <hr
    class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0"
  />

  <!-- Main Features -->
  {
    homepageData.main_features.enable && (
      <section class="section pt-30 xl:pt-37">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              <h2
                class="title hasHighlight  "
                set:html={markdownify(homepageData.main_features.title)}
              />
              <p class="subtitle">{homepageData.main_features.content}</p>
            </div>
            <div class="section-content">
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
                {homepageData.main_features.items.map((item: any) => (
                  <div class="bg-body border border-border rounded-2xl p-6">
                    <h3 class="text-white font-bold mb-2">{item.title}</h3>
                    <p class="text-text text-sm">{item.content}</p>
                  </div>
                ))}
              </div>
              {homepageData.main_features.closing && (
                <div class="text-center">
                  <p class="text-h6-sm text-white font-semibold mb-7 max-w-180 mx-auto">
                    {homepageData.main_features.closing}
                  </p>
                  <a class="btn btn-primary" href="/contact">
                    Let's Identify Your Business Challenges
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Value Proposition -->
  {
    homepageData.value_props.enable && (
      <section class="section relative overflow-hidden">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              <h2
                class="title hasHighlight  "
                set:html={markdownify(homepageData.value_props.title)}
              />
              <p class="subtitle">{homepageData.value_props.content}</p>
            </div>
            <div class="section-content">
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2 mb-9">
                {homepageData.value_props.items.map((item: any) => (
                  <ValueCard
                    logo={item.logo}
                    title={item.title}
                    list={item.list}
                  />
                ))}
              </div>
              <div class="flex justify-center">
                <a class="btn btn-primary" href="/solutions">
                  Explore All Solutions
                </a>
              </div>
            </div>
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Growth Process -->
  {
    homepageData.growth_process.enable && (
      <section class="section-box max-lg:overflow-hidden pb-16 xl:pb-19 bg-transparent relative isolate overflow-hidden">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              <h2
                class="title hasHighlight  "
                set:html={markdownify(homepageData.growth_process.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 xl:gap-16">
                {homepageData.growth_process.items.map((item: any) => (
                  <ProcessCard
                    logo={item.logo}
                    title={item.title}
                    content={item.content}
                  />
                ))}
              </div>
              {homepageData.growth_process.highlighted_statement && (
                <p class="text-center text-h6-sm text-white font-semibold mt-12 max-w-180 mx-auto">
                  {homepageData.growth_process.highlighted_statement}
                </p>
              )}
              {homepageData.growth_process.button.enable && (
                <div class="flex justify-center mt-10 xl:mt-18">
                  <a
                    href={homepageData.growth_process.button.link}
                    class="btn btn-primary"
                  >
                    {homepageData.growth_process.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
        <div class="absolute inset-x-0 top-0 -z-10">
          <svg
            class="w-full"
            viewBox="0 0 1920 1099"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M960 1.5C1224.88 1.5 1464.62 62.943 1638.08 162.205C1811.58 261.491 1918.5 398.425 1918.5 549.356C1918.5 700.287 1811.58 837.222 1638.08 936.508C1464.62 1035.77 1224.88 1097.21 960 1097.21C695.116 1097.21 455.383 1035.77 281.923 936.508C108.42 837.222 1.50012 700.287 1.5 549.356C1.5 398.425 108.42 261.491 281.923 162.205C455.383 62.943 695.116 1.5 960 1.5Z"
              fill="black"
              stroke="url(#paint0_linear_proc)"
              stroke-width="3"
            />
            <defs>
              <linearGradient
                id="paint0_linear_proc"
                x1="960"
                y1="0"
                x2="960"
                y2="84.3521"
                gradientUnits="userSpaceOnUse"
              >
                <>
                  <stop stop-color="var(--color-primary-light)" />
                  <stop offset="1" stop-color="var(--color-body)" />
                </>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="absolute inset-0 grid place-items-center size-full -z-10">
          <div class="size-225 bg-radial from-primary-light/30 to-transparent from-0% to-70% rounded-full" />
        </div>
      </section>
    )
  }

  <!-- Integrations -->
  {
    homepageData.integrations.enable && (
      <section class="section relative isolate max-md:overflow-hidden">
        <div class="container-sm">
          <div class="section-intro centralize">
            <h2
              class="title hasHighlight  "
              set:html={markdownify(homepageData.integrations.title)}
            />
          </div>
        </div>
        <div class="w-full flex flex-col gap-6 mt-12">
          {(() => {
            const items = homepageData.integrations.items;
            const mid = Math.ceil(items.length / 2);
            const rowA = items.slice(0, mid);
            const rowB = items.slice(mid);
            const chip = (item: any) => (
              <div class="size-16 sm:size-24 md:size-28 shrink-0 bg-text-light/10 backdrop-blur-xl rounded-full grid place-items-center p-3.5 sm:p-5 mx-1.5 sm:mx-2">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="size-full object-contain"
                  loading="lazy"
                />
              </div>
            );
            return (
              <>
                <div class="marquee-row">
                  <div class="marquee-track marquee-left">
                    {[...rowA, ...rowA].map((item) => chip(item))}
                  </div>
                </div>
                <div class="marquee-row">
                  <div class="marquee-track marquee-right">
                    {[...rowB, ...rowB].map((item) => chip(item))}
                  </div>
                </div>
              </>
            );
          })()}
        </div>
        <div class="absolute inset-0 grid place-items-center size-full -z-10">
          <div class="size-180 xl:size-225 bg-radial from-primary-light/40 to-transparent from-0% to-70% rounded-full" />
        </div>
      </section>
    )
  }

  <!-- HR Wala Product Showcase -->
  {
    homepageData.hr_wala_showcase.enable && (
      <section class="section relative isolate">
        <div class="container">
          <div class="rounded-3xl bg-light/6 p-8 lg:p-14">
            <div class="lg:max-w-180">
              <p class="text-primary-light font-semibold text-sm mb-2">
                {homepageData.hr_wala_showcase.badge}
              </p>
              <h2
                class="text-h3-sm lg:text-h2 font-bold text-white mb-3"
                set:html={markdownify(homepageData.hr_wala_showcase.title)}
              />
              <p class="text-h6 text-white font-semibold mb-5">
                {homepageData.hr_wala_showcase.subtitle}
              </p>
              <p class="text-text mb-8">
                {homepageData.hr_wala_showcase.content}
              </p>
            </div>
            <div class="flex flex-wrap gap-2.5 mb-10">
              {homepageData.hr_wala_showcase.themes.map((t: string) => (
                <span class="text-sm text-text bg-white/5 ring-1 ring-white/10 rounded-full px-4 py-1.5">
                  {t}
                </span>
              ))}
            </div>
            {homepageData.hr_wala_showcase.button.enable && (
              <a
                class="btn btn-primary"
                href={homepageData.hr_wala_showcase.button.link}
              >
                {homepageData.hr_wala_showcase.button.label}
              </a>
            )}
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Industries Served -->
  <BusinessNeeds />

  <!-- Internal Applications & Product Development -->
  {
    homepageData.internal_applications.enable && (
      <section class="section relative isolate">
        <div class="container">
          <div class="section-intro centralize">
            <p class="text-primary-light font-semibold text-sm mb-2">
              {homepageData.internal_applications.badge}
            </p>
            <h2
              class="title hasHighlight"
              set:html={markdownify(homepageData.internal_applications.title)}
            />
            <p class="subtitle">{homepageData.internal_applications.content}</p>
          </div>
          <div class="section-content">
            <div class="grid md:grid-cols-3 gap-6 mb-8">
              {homepageData.internal_applications.items.map((item: any) => (
                <div class="bg-body border border-border rounded-2xl p-6">
                  <h3 class="text-white font-bold mb-2">{item.title}</h3>
                  <p class="text-text text-sm">{item.content}</p>
                </div>
              ))}
            </div>
            {homepageData.internal_applications.disclaimer && (
              <p class="text-center text-text-dark text-sm italic mb-8">
                {homepageData.internal_applications.disclaimer}
              </p>
            )}
            {homepageData.internal_applications.button.enable && (
              <div class="flex justify-center">
                <a
                  class="btn btn-primary"
                  href={homepageData.internal_applications.button.link}
                >
                  {homepageData.internal_applications.button.label}
                </a>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Leadership Teaser -->
  {
    homepageData.leadership_teaser.enable && (
      <section class="section relative isolate">
        <div class="container">
          <div class="rounded-3xl bg-light/6 p-8 lg:p-14 text-center max-w-200 mx-auto">
            <p class="text-primary-light font-semibold text-sm mb-2">
              {homepageData.leadership_teaser.badge}
            </p>
            <h2
              class="text-h4-sm lg:text-h3 font-bold text-white mb-4"
              set:html={markdownify(homepageData.leadership_teaser.title)}
            />
            <p class="text-text mb-8">{homepageData.leadership_teaser.content}</p>
            {homepageData.leadership_teaser.button.enable && (
              <a
                class="btn btn-primary"
                href={homepageData.leadership_teaser.button.link}
              >
                {homepageData.leadership_teaser.button.label}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <Faq />

  <CallToAction />
</Base>
