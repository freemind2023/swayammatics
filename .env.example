# Airtable (CRM — system of record for the contact form)
# Base: https://airtable.com/create/tokens (personal access token with data.records:write)
AIRTABLE_API_KEY=
# Base ID (starts with "app")
AIRTABLE_BASE_ID=
# Table name, defaults to "Contacts" if unset
AIRTABLE_TABLE_NAME=Contacts

# Resend (contact sync + transactional email)
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sending address, e.g. "Swayamatics <hello@swayamatics.com>"
RESEND_FROM_EMAIL=
# Internal inbox that receives new-enquiry notifications (defaults to RESEND_FROM_EMAIL if unset)
NOTIFY_EMAIL=
# Optional: Resend Audience ID to sync enquiry contacts into (non-marketing, unsubscribed by default)
RESEND_AUDIENCE_ID=

# Stripe Settings (unused by Swayamatics — retained from template, remove if not needed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GoHighLevel (unused by Swayamatics — retained from template, remove if not needed)
GHL_API_KEY=
GHL_LOCATION_ID=

# Sentry (error monitoring) — not yet wired up, see build report
SENTRY_DSN=

# Google Tag Manager — set google_tag_manager.enable=true in src/config/config.json once this is set
GTM_ID=
