---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import { getListPage } from "@/lib/contentParser.astro";
import type { Contact } from "@/types";

const contact = await getListPage("contact", "-index");
const contactData: Contact = contact.data;

const improvementOptions = [
  "Business Process Automation",
  "AI & Intelligent Automation",
  "CRM & Sales Automation",
  "HR & Workforce Management",
  "System Integration",
  "Custom Software",
  "Business Intelligence",
  "Digital Transformation",
  "Not Sure Yet",
];
---

<Base {...contactData}>
  <PageHeader
    title={contactData.page_header!.title}
    subtitle={contactData.page_header!.subtitle}
  />

  <!-- Contact Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 lg:col-10">
          <div class="p-8 md:p-10 bg-white/5 rounded-2xl">
            <h2 class="text-h5-sm md:text-h4 font-bold text-white mb-8">
              Tell Us What You Want to Improve.
            </h2>
            <form id="contact-form" novalidate class="flex flex-col gap-6">
              <div class="grid sm:grid-cols-2 gap-5">
                <input
                  type="text"
                  name="full_name"
                  placeholder="Full Name *"
                  required
                  class="input-field"
                />
                <input
                  type="email"
                  name="email"
                  placeholder="Business Email *"
                  required
                  class="input-field"
                />
                <input
                  type="tel"
                  name="phone"
                  placeholder="Phone Number *"
                  required
                  class="input-field"
                />
                <input
                  type="text"
                  name="company"
                  placeholder="Company Name *"
                  required
                  class="input-field"
                />
                <input
                  type="url"
                  name="website"
                  placeholder="Website (optional)"
                  class="input-field"
                />
                <select name="industry" required class="input-field" data-placeholder-select>
                  <option value="" disabled selected>Industry *</option>
                  <option>Manufacturing</option>
                  <option>Healthcare</option>
                  <option>Education</option>
                  <option>Professional Services</option>
                  <option>Real Estate & Construction</option>
                  <option>Financial & Business Services</option>
                  <option>E-commerce</option>
                  <option>Logistics</option>
                  <option>Other</option>
                </select>
                <select name="company_size" required class="input-field" data-placeholder-select>
                  <option value="" disabled selected>Company Size *</option>
                  <option>1–10 employees</option>
                  <option>11–50 employees</option>
                  <option>51–200 employees</option>
                  <option>201–500 employees</option>
                  <option>500+ employees</option>
                </select>
                <select name="preferred_contact_method" required class="input-field" data-placeholder-select>
                  <option value="" disabled selected>Preferred Contact Method *</option>
                  <option>Phone</option>
                  <option>Email</option>
                  <option>WhatsApp</option>
                  <option>Online Meeting</option>
                </select>
              </div>

              <fieldset class="flex flex-col gap-3">
                <legend class="text-white font-medium mb-2">
                  What would you like to improve? *
                </legend>
                <div class="grid sm:grid-cols-2 gap-x-5 gap-y-3">
                  {improvementOptions.map((opt) => (
                    <label class="flex items-center gap-3 text-text cursor-pointer">
                      <input
                        type="checkbox"
                        name="improvements"
                        value={opt}
                        class="size-4 accent-primary"
                      />
                      <span>{opt}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <textarea
                name="project_description"
                placeholder="Describe Your Business Challenge *"
                rows={5}
                required
                class="input-field resize-none"
              ></textarea>

              <label class="flex items-start gap-3 text-sm text-text cursor-pointer">
                <input
                  type="checkbox"
                  name="consent"
                  required
                  class="mt-1 size-4 accent-primary"
                />
                <span>
                  I consent to Swayammatics using the information submitted to respond to my enquiry, in accordance with its Privacy Policy. *
                </span>
              </label>

              <div class="flex flex-col gap-4">
                <div
                  id="form-success"
                  class="hidden rounded-2xl bg-green-500/10 border border-green-500/30 px-6 py-4 text-green-400 text-base"
                >
                  ✅ Thank you for reaching out to Swayammatics. Your enquiry has been received. Our team will review your requirements and get in touch.
                </div>
                <div
                  id="form-error"
                  class="hidden rounded-2xl bg-red-500/10 border border-red-500/30 px-6 py-4 text-red-400 text-base"
                >
                  ⚠️ <span id="form-error-text"
                    >Something went wrong. Please try again.</span
                  >
                </div>

                <button
                  type="submit"
                  id="contact-submit"
                  class="btn btn-primary w-full py-4 text-lg font-medium transition-opacity disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="submit-label">Submit Enquiry</span>
                  <span id="submit-loading" class="hidden">Sending…</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>

<style>
  @reference "../styles/main.css";
  .input-field {
    @apply w-full rounded-2xl bg-white/5 backdrop-blur-[44px] px-6 py-4 border border-border text-white placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors;
  }
</style>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const submitBtn = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement | null;
  const submitLabel = document.getElementById("submit-label");
  const submitLoading = document.getElementById("submit-loading");
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const errorText = document.getElementById("form-error-text");

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel || !submitLoading) return;
    submitBtn.disabled = loading;
    submitLabel.classList.toggle("hidden", loading);
    submitLoading.classList.toggle("hidden", !loading);
  }

  function showSuccess() {
    successEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    form?.reset();
  }

  function showError(msg?: string) {
    errorEl?.classList.remove("hidden");
    successEl?.classList.add("hidden");
    if (errorText && msg) errorText.textContent = msg;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    successEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");

    const formData = new FormData(form);
    const improvements = formData.getAll("improvements");

    if (improvements.length === 0) {
      showError("Please select at least one thing you'd like to improve.");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          full_name: formData.get("full_name"),
          email: formData.get("email"),
          phone: formData.get("phone"),
          company: formData.get("company"),
          website: formData.get("website"),
          industry: formData.get("industry"),
          company_size: formData.get("company_size"),
          improvements,
          project_description: formData.get("project_description"),
          preferred_contact_method: formData.get("preferred_contact_method"),
          consent: formData.get("consent") === "on",
          landing_page: window.location.pathname,
          utm: window.location.search,
        }),
      });

      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        showSuccess();
      } else {
        showError(json.error ?? "Something went wrong. Please try again.");
      }
    } catch {
      showError("Network error — please check your connection and try again.");
    } finally {
      setLoading(false);
    }
  });
</script>
